config uuplugin
	option enabled '0'
	# 上报给网易云端的设备名（写进 h3c_info 的 productname），UU App 里显示的
	# 就是它。与下面的 oem_model 不是一个东西：那个决定下载哪家的厂商包。
	# 改它等于换了一台设备，云端会要求重新绑定。
	option model 'RE-CS-02'
	option addfw '1'
	# auto = NetEase's plain OpenWrt build (consoles only)
	# oem  = its vendor build, which also boosts PCs and phones
	option arch 'auto'
	# h3c-nx30pro | h3c-bx54   (only used when arch is 'oem')
	option oem_model 'h3c-nx30pro'
	# Empty means detect. Override only if detection is wrong:
	# x86_64 | aarch64 | arm | mipsel | mipseb
	option arch_force ''
	# off | cooperative | bypass
	option openclash_mode 'cooperative'
	# Shared by every coexistence daemon: how often to re-check UU's routes,
	# and the widest route that may be exempted.
	option oc_interval '5'
	option oc_min_prefix '8'
	# off | cooperative   (only acts while UA3F is installed and running)
	option ua3f_mode 'cooperative'
	# off | cooperative   (only acts while PassWall is installed)
	option passwall_mode 'cooperative'
	# seconds; independent of oc_interval, which belongs to the OpenClash tab
	option passwall_interval '5'
	# off | cooperative   (only acts while HomeProxy is installed and running)
	option homeproxy_mode 'cooperative'
	# all | blacklist | whitelist
	option device_mode 'all'
	# match devices by MAC as well as IP
